###
### aohp-containerd: native daemon providing chroot-based Linux container
### environments for the AOHP agent app.
###

# mlstrustedsubject: read-only probing of app processes (/proc/<pid>/stat of an
# untrusted_app at s0:c512,c768) is otherwise refused by the MLS dominance constraint even
# with the type-enforcement rules below; same attribute storaged/lmkd/dumpstate carry.
type aohp_container_daemon, domain, coredomain, mlstrustedsubject;
type aohp_container_daemon_exec, exec_type, file_type, system_file_type;
type aohp_container_data_file, file_type, data_file_type, core_data_file_type;

init_daemon_domain(aohp_container_daemon)

# apk/pip need real outbound TCP (HTTPS) and UDP (DNS via musl resolver); use the same
# port labeling as netdomain — plain "port:tcp_socket name_connect" is not sufficient.
net_domain(aohp_container_daemon)

# Parent of /data/aohp is labeled system_data_file; without this, mkdir("/data/aohp") is
# denied and container creation fails (env paths never get created).
allow aohp_container_daemon system_data_file:dir create_dir_perms;
file_type_auto_trans(aohp_container_daemon, system_data_file, aohp_container_data_file)

# Core capabilities for chroot / namespace / mount / user switching.
allow aohp_container_daemon self:capability {
    sys_chroot sys_admin setuid setgid kill
    dac_override dac_read_search fowner chown fsetid
};

# Process operations (setsid for detached services; setpgid for session).
allow aohp_container_daemon self:process { fork setexec sigchld sigkill sigstop signal setpgid };

# Read-only process probing of host pids from inside a container (ps, pidof, pgrep,
# lock/lease liveness checks such as OpenClaw's agent_database_leases "is pid N alive?").
# The container shares the host pid namespace, so a probe targets every domain:
#  - kill(pid, 0) is process:signull; without it the probe fails EPERM (not ESRCH), so a
#    dead-and-recycled pid looks alive and the gateway refuses to start after an unclean reboot.
#  - /proc/<pid>/{stat,status,cmdline} are labeled with the target's domain (dir search/read,
#    file open/read/getattr); cmdline additionally takes the ptrace_may_access(PTRACE_MODE_READ)
#    path, which SELinux maps to domain:file read. process:getattr is /proc/<pid>/attr for ps -Z.
# No ptrace, no signal delivery, no writes. Same read-only set as storaged/lmkd/dumpstate.
allow aohp_container_daemon domain:process { signull getattr };
r_dir_file(aohp_container_daemon, domain)
# Container workloads (Node/V8 JIT, WebAssembly for fetch/undici, Python JITs) need anonymous
# executable memory. Without this every PROT_EXEC mmap/mprotect fails with EACCES and V8 aborts
# ("Check failed: 12 == errno"); the historical workaround was NODE_OPTIONS=--jitless, which in
# turn disables WebAssembly and breaks fetch(). Same grant as webview_zygote / hal_drm.
allow aohp_container_daemon self:process execmem;

# Mount-namespace isolation for container children (unshare + make-rslave /), as zygote does.
# Without mounton on rootfs the MS_SLAVE step fails and child bind mounts propagate to the host.
allow aohp_container_daemon rootfs:dir mounton;
# Node reads /proc/meminfo for heap sizing.
allow aohp_container_daemon proc_meminfo:file r_file_perms;

# cgroup v2: create child groups and write interface files (no file create on cgroupfs).
allow aohp_container_daemon cgroup_v2:dir create_dir_perms;
allow aohp_container_daemon cgroup_v2:file rw_file_perms;

# Container data directory under /data/aohp/.
allow aohp_container_daemon aohp_container_data_file:dir create_dir_perms;
allow aohp_container_daemon aohp_container_data_file:file create_file_perms;
# Alpine apk installs packages by hardlinking extracted temp files into place (linkat).
# Without this, apk reports "Permission denied" / rename failures under etc/terminfo.
allow aohp_container_daemon aohp_container_data_file:file link;
allow aohp_container_daemon aohp_container_data_file:lnk_file create_file_perms;
allow aohp_container_daemon aohp_container_data_file:sock_file create_file_perms;
allow aohp_container_daemon aohp_container_data_file:fifo_file create_file_perms;

# Execute binaries inside the container rootfs.
allow aohp_container_daemon aohp_container_data_file:file { execute execute_no_trans };

# Bind-mount targets live under /data/aohp/.../rootfs/* (aohp_container_data_file).
allow aohp_container_daemon aohp_container_data_file:dir mounton;

# After /dev is bound, paths under rootfs/dev/ may appear as tmpfs; repeat binds see proc/sysfs/device inodes.
allow aohp_container_daemon tmpfs:dir mounton;
allow aohp_container_daemon proc:dir mounton;
allow aohp_container_daemon proc_type:dir mounton;
allow aohp_container_daemon sysfs:dir mounton;
allow aohp_container_daemon device:dir mounton;
allow aohp_container_daemon fuse:dir mounton;

# Mount operations (bind mount /proc, /dev, /sys, /sdcard into container rootfs).
allow aohp_container_daemon proc:filesystem mount;
allow aohp_container_daemon devpts:filesystem mount;
allow aohp_container_daemon sysfs:filesystem mount;
allow aohp_container_daemon tmpfs:filesystem mount;

# Read rootfs templates from /system/etc/aohp/rootfs-templates/.
allow aohp_container_daemon system_file:file r_file_perms;
allow aohp_container_daemon system_file:dir r_dir_perms;

# Access /sdcard (FUSE / sdcardfs): list, read, and create dirs/files (e.g. mkdir under /sdcard in chroot).
allow aohp_container_daemon { sdcard_type fuse }:dir { r_dir_perms create_dir_perms };
allow aohp_container_daemon { sdcard_type fuse }:file { r_file_perms create_file_perms };
allow aohp_container_daemon mnt_user_file:dir r_dir_perms;
allow aohp_container_daemon mnt_user_file:lnk_file r_file_perms;

# PTY for interactive shell sessions.
allow aohp_container_daemon devpts:chr_file { open read write ioctl getattr setattr };

# busybox/apk use TIOCGWINSZ (0x5413) on stdout/stderr pipes and /tmp/.aohp_lastpwd.
allowxperm aohp_container_daemon self:fifo_file ioctl unpriv_tty_ioctls;
allowxperm aohp_container_daemon aohp_container_data_file:file ioctl unpriv_tty_ioctls;

# Socket: init creates /dev/socket/aohp_container for us; no sock_file create/unlink needed.
allow aohp_container_daemon self:unix_stream_socket { create listen accept read write getattr setattr setopt };

# /dev access for container.
allow aohp_container_daemon device:dir r_dir_perms;
allow aohp_container_daemon null_device:chr_file rw_file_perms;
allow aohp_container_daemon zero_device:chr_file r_file_perms;
allow aohp_container_daemon random_device:chr_file r_file_perms;

# --- Container networking (VPN / WireGuard / routing from inside the sandbox) ---
# Matching rc: capabilities += CHOWN FSETID NET_ADMIN NET_RAW. CAP_CHOWN/FSETID were already
# allowed here but absent from the rc bounding set, so dpkg-statoverride/useradd-style chown
# failed with EPERM (dbus postinst). NET_ADMIN/NET_RAW let the agent create and configure
# interfaces (wg0, tun), addresses, routes, rules and firewall marks.
allow aohp_container_daemon self:capability { net_admin net_raw };
allow aohp_container_daemon self:netlink_route_socket { create_socket_perms_no_ioctl nlmsg_read nlmsg_write };
allow aohp_container_daemon self:netlink_generic_socket create_socket_perms_no_ioctl;
allow aohp_container_daemon self:netlink_netfilter_socket create_socket_perms_no_ioctl;
allow aohp_container_daemon self:netlink_xfrm_socket { create_socket_perms_no_ioctl nlmsg_read nlmsg_write };
allow aohp_container_daemon self:tun_socket create_socket_perms_no_ioctl;
allow aohp_container_daemon self:rawip_socket create_socket_perms_no_ioctl;
allow aohp_container_daemon self:packet_socket create_socket_perms_no_ioctl;
allow aohp_container_daemon tun_device:chr_file rw_file_perms;
# sysctl: net.ipv4.ip_forward, rp_filter, src_valid_mark (wg-quick) etc.
allow aohp_container_daemon proc_net_type:file rw_file_perms;

# --- Linux-userland denials seen on real devices (OnePlus 13 dodge enforcing, Fedora template in Cuttlefish) ---

# Audit netlink: libaudit users (sshd, PAM, sudo, su, login) open an AF_NETLINK/NETLINK_AUDIT
# socket at start-up and get EPERM without this -> sshd drops every interactive session,
# PAM account checks fail. Same grant as init/logd; removes the need for an LD_PRELOAD
# libnoaudit.so shim in the container.
allow aohp_container_daemon self:netlink_audit_socket { create_socket_perms_no_ioctl nlmsg_relay nlmsg_read nlmsg_write };
# ... and actually *sending* a record (AUDIT_USER_* via audit_log_user_message, which the sshd
# pty session path and PAM/sudo call) needs CAP_AUDIT_WRITE: the kernel checks
# netlink_capable(skb, CAP_AUDIT_WRITE) and answers EPERM otherwise, which libaudit treats as
# fatal ("linux_audit_write_entry failed: Operation not permitted" -> session dropped). The
# matching rc adds AUDIT_WRITE to the service's capability set; together they retire the
# LD_PRELOAD libnoaudit.so shim in the container's sshd unit.
allow aohp_container_daemon self:global_capability_class_set audit_write;

# /proc reads from ordinary tools: the OpenClaw gateway polls /proc/stat ~1/s (floods logcat
# with denials), sed/install/ls read /proc/filesystems, python/node read /proc/version,
# /proc/uptime, /proc/sys/vm/overcommit_memory, uptime/top read /proc/loadavg.
allow aohp_container_daemon {
    proc_stat proc_filesystems proc_version proc_uptime proc_overcommit_memory proc_loadavg
}:file r_file_perms;

# io_uring: libuv (Node) probes io_uring_setup() at start-up (65 anon_inode create denials per
# gateway start). Standard macro: named type transition to aohp_container_daemon_iouring plus
# create/map/read/write on it and self:io_uring sqpoll.
io_uring_use(aohp_container_daemon)

# ioctls on container files beyond the tty set already allowed above:
#  FICLONE (0x9409, cp --reflink / coreutils install on f2fs), FICLONERANGE (0x940d),
#  FIDEDUPERANGE (0x94c6) -- the three have no name in public/ioctl_defines, hence numeric;
#  TCGETS2 (0x542a, glibc tcgetattr via isatty() on a regular file, e.g. ldd),
#  FS_IOC_GETFLAGS/SETFLAGS (lsattr/chattr), FS_IOC_FIEMAP (filefrag, cp sparse detection).
allowxperm aohp_container_daemon aohp_container_data_file:file ioctl {
    0x9409 0x940d 0x94c6 TCGETS2 FS_IOC_GETFLAGS FS_IOC_SETFLAGS FS_IOC_FIEMAP
};

# sysfs block attributes: dnf/libdnf (Fedora template) reads /sys/block/dm-*/queue/rotational
# for its disk-space / IO scheduling probe (tcontext sysfs_dm: dir search + file read).
allow aohp_container_daemon sysfs_dm:dir search;
allow aohp_container_daemon sysfs_dm:file r_file_perms;

# NOT granted: generic sysfs:file read (openclaw-gatewa reading an unlabeled sysfs "model" once per
# gateway start). private/coredomain.te:142 neverallows coredomain access to unlabeled sysfs files
# (full_treble_only); the file would need its own label in file_contexts first. Harmless, 1/boot.

# NOT granted: self:capability sys_ptrace (pgrep -f on a host pid, 4 denials). private/domain.te
# neverallows sys_ptrace for every domain outside a fixed allowlist (vold, dumpstate, storaged,
# system_server, ...); pgrep falls back to matching on comm, which is enough for the container.

# GPU for Linux GUI apps inside the env (2026-10-09, GPU scope REPORT.md section 6 block A).
# /dev/kgsl-3d0 (qcom, OnePlus 13) and /dev/mali0 (gs101, Pixel 6) are gpu_device. Mesa
# turnip/freedreno open the KGSL node directly from the env; the Pixel's virgl proxy will run in
# this domain too. Coredomain carries no ioctl xperm filter on gpu_device (gs101 filters
# appdomain only), so rw_file_perms covers the KGSL/mali ioctl set. sysfs_gpu = mali sysfs
# attributes (gs101 genfs); the qcom kgsl sysfs model file is already domain-readable.
allow aohp_container_daemon gpu_device:chr_file rw_file_perms;
allow aohp_container_daemon gpu_device:dir r_dir_perms;
allow aohp_container_daemon sysfs_gpu:file r_file_perms;
# Window buffers for X11/Wayland presentation: Mesa (freedreno on KGSL) allocates the shared
# buffers it hands to the display server as dma-bufs from /dev/dma_heap/system. Denied on dodge
# build-6 enforcing: 'kgsl_bo_new_dmabuf: Failed to allocate dma-buf' / avc { read } for name="system"
# tcontext=dmabuf_system_heap_device:chr_file. Only the system heap; vendor heaps stay denied.
allow aohp_container_daemon dmabuf_heap_device:dir r_dir_perms;
allow aohp_container_daemon dmabuf_system_heap_device:chr_file r_file_perms;

# HostExec= units (aohp-containerd runs the unit on the Android host, no chroot, same domain). First
# user: the Termux:X11 display server, started as 'app_process ... com.termux.x11.CmdEntryPoint :0'
# with TMPDIR=<rootfs>/tmp so X clients in the env reach it over /tmp/.X11-unix/X0. It is a native
# non-app process drawing into a Surface — the same shape as bootanim, so the same grants
# (measured on dodge build-7 with the server run under this domain, permissive; 2026-10-09).
allow aohp_container_daemon shell_exec:file rx_file_perms;   # /system/bin/sh -c for HostExec= units
allow aohp_container_daemon zygote_exec:file rx_file_perms;  # app_process
allow aohp_container_daemon apk_data_file:dir r_dir_perms;   # CLASSPATH=/data/app/.../base.apk
allow aohp_container_daemon apk_data_file:file r_file_perms;
allow aohp_container_daemon dalvikcache_data_file:dir r_dir_perms;
allow aohp_container_daemon dalvikcache_data_file:file r_file_perms;
binder_use(aohp_container_daemon)
binder_call(aohp_container_daemon, surfaceflinger)
binder_call(aohp_container_daemon, system_server)
hal_client_domain(aohp_container_daemon, hal_graphics_allocator)
allow aohp_container_daemon hal_graphics_allocator:fd use;
allow aohp_container_daemon surfaceflinger_service:service_manager find;
allow aohp_container_daemon surfaceflinger:unix_stream_socket { read write };
allow aohp_container_daemon { display_service activity_service package_service }:service_manager find;
# ART boot-image / odex lookup under /data/misc/apexdata/com.android.art; without it app_process dies
# (SIGKILL within 80 ms, no abort) on build-8 enforcing while it runs fine permissive. Read-only.
allow aohp_container_daemon apex_module_data_file:dir search;
allow aohp_container_daemon apex_art_data_file:dir r_dir_perms;
allow aohp_container_daemon apex_art_data_file:file r_file_perms;
# ART's GC (userfaultfd-based compaction) creates anon_inode:[userfaultfd] and ioctls UFFDIO_API; denied,
# app_process is SIGKILLed ~80 ms in (build-9 enforcing vs fine permissive; the only denials left).
userfaultfd_use(aohp_container_daemon)
# ART JIT: memfd:jit-cache (a tmpfs file) must be writable and executable (dual mapping), like zygote.
type aohp_container_daemon_tmpfs, file_type;
tmpfs_domain(aohp_container_daemon)
allow aohp_container_daemon aohp_container_daemon_tmpfs:file execute;
# ART reads the on-device-signing status and the apex list at startup (dmesg denials on build-10).
get_prop(aohp_container_daemon, odsign_prop)
get_prop(aohp_container_daemon, build_attestation_prop)
allow aohp_container_daemon apex_info_file:file r_file_perms;
# ART then stats the apexes listed there (/vendor/apex, like priv_app) and /mnt/expand; the X server
# reads the display density property (dmesg on build-11 enforcing).
r_dir_file(aohp_container_daemon, vendor_apex_file)
allow aohp_container_daemon mnt_expand_file:dir getattr;
get_prop(aohp_container_daemon, qemu_sf_lcd_density_prop)
